{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app.py"
    }
  ],
  "env": {
    "PORT": "8001"
  },
  "functions": {
    "app.py": {
      "memory": 1024,
      "maxDuration": 60,
      "excludeFiles": "{scripts/**,__pycache__/**,debug_optimize.py,venv/**,.env*}"
    }
  }
}